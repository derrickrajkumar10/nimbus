{
 "version": 8,
 "name": "NIMBUS Deep tide",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#0C2347"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#0A1F44"
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#0F2850",
    "fill-opacity": 0.9
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "minor",
     "service",
     "track",
     "path"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#183764",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     0.48,
     16,
     2.4,
     19,
     7.199999999999999
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk",
     "primary",
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#183764",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     0.8800000000000001,
     16,
     4.4,
     19,
     13.200000000000001
    ]
   }
  },
  {
   "id": "road-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "transportation_name",
   "minzoom": 14,
   "layout": {
    "symbol-placement": "line",
    "text-field": [
     "coalesce",
     [
      "get",
      "name:latin"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 11
   },
   "paint": {
    "text-color": "#A9C6DB",
    "text-opacity": 0.6,
    "text-halo-color": "#0C2347",
    "text-halo-width": 1
   }
  }
 ]
}