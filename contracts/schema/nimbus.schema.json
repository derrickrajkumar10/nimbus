{
  "title": "Nimbus",
  "$defs": {
    "Agent": {
      "enum": [
        "sentinel",
        "verifier",
        "triage",
        "pathfinder",
        "dispatcher",
        "herald",
        "chronicler",
        "commander"
      ],
      "title": "Agent",
      "type": "string"
    },
    "AgentActivity": {
      "additionalProperties": false,
      "description": "One line in the console's agent activity feed.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "sim_time": {
          "format": "date-time",
          "title": "Sim Time",
          "type": "string"
        },
        "emitted_at": {
          "description": "Wall time, for logs only. Domain logic uses sim_time.",
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "source": {
          "examples": [
            "sentinel",
            "replay-driver",
            "console"
          ],
          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "agent.activity",
          "default": "agent.activity",
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/AgentActivityDetail"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "sim_time",
        "emitted_at",
        "source",
        "detail"
      ],
      "title": "AgentActivity",
      "type": "object"
    },
    "AgentActivityDetail": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent"
        },
        "saw": {
          "title": "Saw",
          "type": "string"
        },
        "decided": {
          "title": "Decided",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "saw",
        "decided",
        "why"
      ],
      "title": "AgentActivityDetail",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AlertScope"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "examples": [
              "27320162-0"
            ],
            "pattern": "^\\d+-\\d+$",
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "recipient_count": {
          "minimum": 0,
          "title": "Recipient Count",
          "type": "integer"
        },
        "message_en": {
          "title": "Message En",
          "type": "string"
        },
        "message_ta": {
          "title": "Message Ta",
          "type": "string"
        },
        "proposal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for Ward Alerts, which go out only via an approved Proposal.",
          "title": "Proposal Id"
        }
      },
      "required": [
        "alert_id",
        "run_id",
        "scope",
        "sent_at",
        "segment_ids",
        "recipient_count",
        "message_en",
        "message_ta"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertScope": {
      "enum": [
        "place",
        "ward"
      ],
      "title": "AlertScope",
      "type": "string"
    },
    "AlertSent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "sim_time": {
          "format": "date-time",
          "title": "Sim Time",
          "type": "string"
        },
        "emitted_at": {
          "description": "Wall time, for logs only. Domain logic uses sim_time.",
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "source": {
          "examples": [
            "sentinel",
            "replay-driver",
            "console"
          ],
          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "alert.sent",
          "default": "alert.sent",
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Alert"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "sim_time",
        "emitted_at",
        "source",
        "detail"
      ],
      "title": "AlertSent",
      "type": "object"
    },
    "ClockTick": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "sim_time": {
          "format": "date-time",
          "title": "Sim Time",
          "type": "string"
        },
        "emitted_at": {
          "description": "Wall time, for logs only. Domain logic uses sim_time.",
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "source": {
          "examples": [
            "sentinel",
            "replay-driver",
            "console"
          ],
          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "clock.tick",
          "default": "clock.tick",
          "title": "Type",
          "type": "string"
        },
        "step_minutes": {
          "default": 15,
          "exclusiveMinimum": 0,
          "title": "Step Minutes",
          "type": "integer"
        },
        "tick_index": {
          "minimum": 0,
          "title": "Tick Index",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "sim_time",
        "emitted_at",
        "source",
        "tick_index"
      ],
      "title": "ClockTick",
      "type": "object"
    },
    "DepthBand": {
      "enum": [
        "dry",
        "ankle",
        "knee",
        "waist",
        "above_waist"
      ],
      "title": "DepthBand",
      "type": "string"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "Hazard": {
      "additionalProperties": false,
      "properties": {
        "hazard_id": {
          "title": "Hazard Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "hazard_class": {
          "$ref": "#/$defs/HazardClass"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "owner": {
          "$ref": "#/$defs/HazardOwner"
        },
        "status": {
          "$ref": "#/$defs/HazardStatus"
        },
        "detected_at": {
          "format": "date-time",
          "title": "Detected At",
          "type": "string"
        },
        "no_go_radius_m": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "No Go Radius M",
          "type": "number"
        },
        "source_report_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Report Id"
        }
      },
      "required": [
        "hazard_id",
        "run_id",
        "hazard_class",
        "location",
        "owner",
        "status",
        "detected_at"
      ],
      "title": "Hazard",
      "type": "object"
    },
    "HazardClass": {
      "enum": [
        "open_manhole",
        "live_wire",
        "fallen_tree",
        "stranded_vehicle"
      ],
      "title": "HazardClass",
      "type": "string"
    },
    "HazardDetected": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
