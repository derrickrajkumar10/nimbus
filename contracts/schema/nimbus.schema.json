          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "hazard.detected",
          "default": "hazard.detected",
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Hazard"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "sim_time",
        "emitted_at",
        "source",
        "detail"
      ],
      "title": "HazardDetected",
      "type": "object"
    },
    "HazardOwner": {
      "enum": [
        "corporation",
        "power_utility"
      ],
      "title": "HazardOwner",
      "type": "string"
    },
    "HazardStatus": {
      "enum": [
        "open",
        "acknowledged",
        "cleared"
      ],
      "title": "HazardStatus",
      "type": "string"
    },
    "LineString": {
      "additionalProperties": false,
      "description": "GeoJSON LineString geometry. Coordinates are [lon, lat].",
      "properties": {
        "type": {
          "default": "LineString",
          "pattern": "^LineString$",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "Passability": {
      "additionalProperties": false,
      "properties": {
        "two_wheeler": {
          "title": "Two Wheeler",
          "type": "boolean"
        },
        "car": {
          "title": "Car",
          "type": "boolean"
        },
        "ambulance": {
          "title": "Ambulance",
          "type": "boolean"
        }
      },
      "required": [
        "two_wheeler",
        "car",
        "ambulance"
      ],
      "title": "Passability",
      "type": "object"
    },
    "PolicyDecided": {
      "additionalProperties": false,
      "description": "Every Cedar decision, allowed or denied. Feeds the console activity feed.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
