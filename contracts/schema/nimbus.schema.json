      },
      "required": [
        "proposal_id",
        "decision",
        "decided_by",
        "proposal"
      ],
      "title": "ProposalDecidedDetail",
      "type": "object"
    },
    "ProposalStatus": {
      "enum": [
        "pending",
        "approved",
        "edited",
        "rejected"
      ],
      "title": "ProposalStatus",
      "type": "string"
    },
    "RankedSos": {
      "additionalProperties": false,
      "properties": {
        "sos_id": {
          "title": "Sos Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "danger_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Danger Score",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "maxItems": 3,
          "title": "Reasons",
          "type": "array"
        },
        "merged_sos_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Merged Sos Ids",
          "type": "array"
        }
      },
      "required": [
        "sos_id",
        "rank",
        "danger_score",
        "reasons"
      ],
      "title": "RankedSos",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "reading_id": {
          "title": "Reading Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
