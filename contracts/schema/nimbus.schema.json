    },
    "ProposalDecidedDetail": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "edited",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decided_by": {
          "title": "Decided By",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/Proposal",
