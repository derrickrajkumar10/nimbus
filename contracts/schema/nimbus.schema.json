          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "depth": {
          "$ref": "#/$defs/DepthBand"
        },
        "reference_object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "examples": [
            "kerb",
            "tyre",
            "knee",
            "wall"
          ],
          "title": "Reference Object"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "passable": {
          "$ref": "#/$defs/Passability"
        },
        "report_ids": {
          "description": "Reports merged into this Reading.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Report Ids",
          "type": "array"
        },
        "hazards_seen": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HazardClass"
          },
          "title": "Hazards Seen",
          "type": "array"
        }
      },
      "required": [
        "reading_id",
        "run_id",
        "segment_id",
        "observed_at",
        "depth",
        "reference_object",
        "confidence",
        "passable",
        "report_ids"
      ],
