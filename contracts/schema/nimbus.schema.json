        "type": {
          "const": "policy.decided",
          "default": "policy.decided",
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/PolicyDecidedDetail"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "sim_time",
        "emitted_at",
        "source",
        "detail"
      ],
      "title": "PolicyDecided",
      "type": "object"
    },
    "PolicyDecidedDetail": {
      "additionalProperties": false,
      "properties": {
        "principal": {
          "$ref": "#/$defs/Agent"
        },
        "action": {
          "examples": [
            "SendAlert",
            "ProposeWorkOrder",
            "DispatchCrew",
            "ReadSOS"
          ],
          "title": "Action",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "action",
        "resource",
        "allowed",
        "reason"
      ],
      "title": "PolicyDecidedDetail",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "run_id": {
          "examples": [
            "live",
            "replay-michaung"
          ],
          "pattern": "^(live|replay-[a-z0-9-]+)$",
          "title": "Run Id",
          "type": "string"
        },
        "proposed_by": {
          "$ref": "#/$defs/Agent"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "discriminator": {
            "mapping": {
              "ward_alert": "#/$defs/WardAlertDraft",
              "work_order": "#/$defs/WorkOrder"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WorkOrder"
            },
            {
              "$ref": "#/$defs/WardAlertDraft"
            }
          ],
          "title": "Action"
        },
        "status": {
          "$ref": "#/$defs/ProposalStatus",
          "default": "pending"
        },
        "decided_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By"
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        }
      },
      "required": [
        "proposal_id",
        "run_id",
        "proposed_by",
        "created_at",
        "rank",
        "reason",
        "action"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "ProposalCreated": {
      "additionalProperties": false,
