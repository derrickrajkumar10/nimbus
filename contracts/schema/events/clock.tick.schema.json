{
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "examples": [
        "live",
        "replay-michaung"
      ],
      "pattern": "^(live|replay-[a-z0-9-]+)$",
      "title": "Run Id",
      "type": "string"
    },
    "sim_time": {
      "format": "date-time",
      "title": "Sim Time",
      "type": "string"
    },
    "emitted_at": {
      "description": "Wall time, for logs only. Domain logic uses sim_time.",
      "format": "date-time",
      "title": "Emitted At",
      "type": "string"
    },
    "source": {
      "examples": [
        "sentinel",
        "replay-driver",
        "console"
      ],
      "title": "Source",
      "type": "string"
    },
    "type": {
      "const": "clock.tick",
      "default": "clock.tick",
      "title": "Type",
      "type": "string"
    },
    "step_minutes": {
      "default": 15,
      "exclusiveMinimum": 0,
      "title": "Step Minutes",
      "type": "integer"
    },
    "tick_index": {
      "minimum": 0,
      "title": "Tick Index",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sim_time",
    "emitted_at",
    "source",
    "tick_index"
  ],
  "title": "ClockTick",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
