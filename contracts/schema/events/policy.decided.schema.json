{
  "$defs": {
    "Agent": {
      "enum": [
        "sentinel",
        "verifier",
        "triage",
        "pathfinder",
        "dispatcher",
        "herald",
        "chronicler",
        "commander"
      ],
      "title": "Agent",
      "type": "string"
    },
    "PolicyDecidedDetail": {
      "additionalProperties": false,
      "properties": {
        "principal": {
          "$ref": "#/$defs/Agent"
        },
        "action": {
          "examples": [
            "SendAlert",
            "ProposeWorkOrder",
            "DispatchCrew",
            "ReadSOS"
          ],
          "title": "Action",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "action",
        "resource",
        "allowed",
        "reason"
      ],
      "title": "PolicyDecidedDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Every Cedar decision, allowed or denied. Feeds the console activity feed.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "examples": [
        "live",
        "replay-michaung"
      ],
      "pattern": "^(live|replay-[a-z0-9-]+)$",
      "title": "Run Id",
      "type": "string"
    },
    "sim_time": {
      "format": "date-time",
      "title": "Sim Time",
      "type": "string"
    },
    "emitted_at": {
      "description": "Wall time, for logs only. Domain logic uses sim_time.",
      "format": "date-time",
      "title": "Emitted At",
      "type": "string"
    },
    "source": {
      "examples": [
        "sentinel",
        "replay-driver",
        "console"
      ],
      "title": "Source",
      "type": "string"
    },
    "type": {
      "const": "policy.decided",
      "default": "policy.decided",
      "title": "Type",
      "type": "string"
    },
    "detail": {
      "$ref": "#/$defs/PolicyDecidedDetail"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sim_time",
    "emitted_at",
    "source",
    "detail"
  ],
  "title": "PolicyDecided",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
